@startuml 06-clases-strategy-adapter
title Vista 2 – Strategy (tipos de respaldo) y Adapter (Acronis Cloud)
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
skinparam nodesep 30
skinparam ranksep 50
skinparam class {
  BackgroundColor<<Singleton>> #FFE6CC
  BackgroundColor<<Multiton>> #FFE6CC
  BackgroundColor<<Strategy>> #DDF0DD
  BackgroundColor<<Adapter>> #DDE8F8
  BackgroundColor<<externo>> #EEEEEE
}
hide empty members
interface IEstrategiaDeRespaldo <<Strategy>> {
  + tipo(): TipoDeRespaldo
  + ejecutar(servidor: ServidorOrigen, proveedor: IProveedorNube, agente: AgenteDeRespaldo): ResultadoDeRespaldo
}
class RespaldoCompleto <<Strategy>>
class RespaldoIncremental <<Strategy>>
class RespaldoDiferencial <<Strategy>>
class ResultadoDeRespaldo {
  - exitoso: boolean
  - idRespaldoNube: String [0..1]
  - motivo: String [0..1]
  - bytesEnviados: long
  + exitoso(): boolean
  + idRespaldoNube(): String
  + motivo(): String
}
interface IProveedorNube <<Adapter>> {
  + configurar(urlCuenta: String, credencial: String): void
  + probarConexion(): boolean
  + ejecutarRespaldo(servidor: ServidorOrigen, tipo: TipoDeRespaldo, idPuntoBase: String): ResultadoDeRespaldo
  + validarRespaldo(idRespaldoNube: String): boolean
  + restaurar(idRespaldoNube: String, servidor: ServidorOrigen, tipo: TipoDeRestauracion, elementos: List<String>, destino: String): boolean
}
class AcronisCloudAdapter <<Adapter>> {
  + {static} TIEMPO_ESPERA_LLAMADA_SEG: int = 30
  + {static} TIEMPO_ESPERA_VALIDACION_SEG: int = 600
  - urlCuenta: String
  - credencial: String
  - api: ApiAcronis
  + configurar(urlCuenta: String, credencial: String): void
  + probarConexion(): boolean
  + ejecutarRespaldo(servidor: ServidorOrigen, tipo: TipoDeRespaldo, idPuntoBase: String): ResultadoDeRespaldo
  + validarRespaldo(idRespaldoNube: String): boolean
  + restaurar(idRespaldoNube: String, servidor: ServidorOrigen, tipo: TipoDeRestauracion, elementos: List<String>, destino: String): boolean
  - nombreDeMaquina(servidor: ServidorOrigen): String
  - metodoDe(tipo: TipoDeRespaldo): String
}
class ApiAcronis <<externo>> {
  + autenticar(token: String): boolean
  + crearRespaldo(maquina: String, metodo: String, base: String): String
  + consultarValidacion(idRespaldo: String): String
  + iniciarRecuperacion(idRespaldo: String, maquina: String, elementos: List<String>, destino: String): boolean
}
class SinConexionException <<exception>>
class AgenteDeRespaldo <<Multiton>>
IEstrategiaDeRespaldo <|.. RespaldoCompleto
IEstrategiaDeRespaldo <|.. RespaldoIncremental
IEstrategiaDeRespaldo <|.. RespaldoDiferencial
IProveedorNube <|.. AcronisCloudAdapter
AgenteDeRespaldo "1" --> "1" IProveedorNube : proveedor
AgenteDeRespaldo "1" o-- "3" IEstrategiaDeRespaldo : estrategias
AcronisCloudAdapter "1" --> "1" ApiAcronis : adapta
IEstrategiaDeRespaldo ..> IProveedorNube : usa
IEstrategiaDeRespaldo ..> ResultadoDeRespaldo : devuelve
IProveedorNube ..> ResultadoDeRespaldo : devuelve
IProveedorNube ..> SinConexionException : <<throws>>
note right of ApiAcronis
  Adaptee externo: sus operaciones son un supuesto
  de modelado (no figuran en el trabajo de OAS).
end note
note bottom of AgenteDeRespaldo
  Context del Strategy: elige la estrategia
  según TareaDeRespaldo.tipo().
end note
@enduml
