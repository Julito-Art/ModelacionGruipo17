@startuml 06-clases-vista-general
title Vista general del diagrama de clases de diseño (solo nombres; el detalle está en las vistas siguientes)
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
skinparam nodesep 30
skinparam ranksep 50
skinparam class {
  BackgroundColor<<Singleton>> #FFE6CC
  BackgroundColor<<Multiton>> #FFE6CC
  BackgroundColor<<Strategy>> #DDF0DD
  BackgroundColor<<Adapter>> #DDE8F8
  BackgroundColor<<externo>> #EEEEEE
}
hide empty members
left to right direction
class PlanificadorDeRespaldos <<Singleton>>
class AgenteDeRespaldo <<Multiton>>
class PoliticaDeRespaldo
class TareaDeRespaldo
class PuntoDeRestauracion
class ResultadoDeRespaldo
interface IEstrategiaDeRespaldo <<Strategy>>
class RespaldoCompleto <<Strategy>>
class RespaldoIncremental <<Strategy>>
class RespaldoDiferencial <<Strategy>>
interface IProveedorNube <<Adapter>>
class AcronisCloudAdapter <<Adapter>>
class ApiAcronis <<externo>>
class SinConexionException <<exception>>
class NotificacionException <<exception>>
class GestorDeAlertas
class Alerta
interface INotificador
class NotificadorPorCorreo
class ServicioDeAuditoria
class RegistroDeAuditoria <<inmutable>>
class SolicitudDeRestauracion
class ServicioDeRestauracion
class Usuario
class InformeMensual
IEstrategiaDeRespaldo <|.. RespaldoCompleto
IEstrategiaDeRespaldo <|.. RespaldoIncremental
IEstrategiaDeRespaldo <|.. RespaldoDiferencial
IProveedorNube <|.. AcronisCloudAdapter
INotificador <|.. NotificadorPorCorreo
PlanificadorDeRespaldos "1" --> "0..2" PoliticaDeRespaldo : gestiona
PlanificadorDeRespaldos "1" --> "1" GestorDeAlertas : usa
PlanificadorDeRespaldos "1" --> "1" ServicioDeAuditoria : usa
AgenteDeRespaldo "1" --> "1" IProveedorNube : proveedor
AgenteDeRespaldo "1" o-- "3" IEstrategiaDeRespaldo : estrategias
AgenteDeRespaldo "1" --> "0..1" TareaDeRespaldo : en curso
AcronisCloudAdapter "1" --> "1" ApiAcronis : adapta
TareaDeRespaldo "1" --> "0..1" PuntoDeRestauracion : genera
TareaDeRespaldo "*" --> "0..1" Usuario : lanzada por
SolicitudDeRestauracion "*" --> "1" PuntoDeRestauracion : sobre
SolicitudDeRestauracion "*" --> "1" Usuario : solicitante
SolicitudDeRestauracion "*" --> "0..1" Usuario : resolutor
Alerta "*" --> "0..1" TareaDeRespaldo : origen
GestorDeAlertas "1" --> "1" INotificador : notifica con
GestorDeAlertas "1" o-- "*" Alerta : abiertas
ServicioDeAuditoria "1" --> "*" RegistroDeAuditoria : registra
ServicioDeRestauracion "1" --> "*" SolicitudDeRestauracion : gestiona
PlanificadorDeRespaldos ..> AgenteDeRespaldo : obtiene (Multiton)
PlanificadorDeRespaldos ..> TareaDeRespaldo : crea
PoliticaDeRespaldo ..> AgenteDeRespaldo : consulta
IEstrategiaDeRespaldo ..> IProveedorNube : usa
IEstrategiaDeRespaldo ..> ResultadoDeRespaldo : devuelve
IProveedorNube ..> ResultadoDeRespaldo : devuelve
IProveedorNube ..> SinConexionException : <<throws>>
INotificador ..> NotificacionException : <<throws>>
GestorDeAlertas ..> ServicioDeAuditoria
ServicioDeRestauracion ..> PlanificadorDeRespaldos : respaldo previo
ServicioDeRestauracion ..> AgenteDeRespaldo : restaurar
ServicioDeRestauracion ..> ServicioDeAuditoria
InformeMensual ..> TareaDeRespaldo
InformeMensual ..> SolicitudDeRestauracion
@enduml
